# Copy to Backend/.env (git-ignored) and fill in. infra/data.sh and
# infra/mq.sh fill in the AWS values for you.

PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated. Also used in links in emails/SMS.
CLIENT_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=0

# ---------- Data: Amazon DynamoDB ----------
AWS_REGION=eu-west-1
DYNAMODB_TABLE=maji-ya-umma
# The backend's IAM user (infra/data.sh keys writes these):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Local development / tests instead (docker compose up -d dynamodb; npm run db:create):
# DYNAMODB_ENDPOINT=http://localhost:8000

# ---------- Sign-in: Firebase Auth (Admin SDK) ----------
FIREBASE_PROJECT_ID=maji-ya-umma
# Service account key: Firebase console → Project settings → Service accounts → Generate new private key.
# Keep this file out of git.
FIREBASE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
# For local testing against the Auth emulator instead (no credentials):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-maji

# ---------- RabbitMQ / Amazon MQ ----------
AMQP_URL=amqp://guest:guest@localhost:5672
# Amazon MQ: infra/mq.sh up sets AMQP_URL (amqps://...:5671) and these broker credentials.
# MQ_USERNAME=
# MQ_PASSWORD=
MQ_QUEUE_TYPE=classic          # quorum recommended on Amazon MQ cluster brokers
MQ_MAX_ATTEMPTS=5
MQ_RETRY_DELAY_MS=10000
# WORKER_QUEUES=paymentsInitiate,paymentsReconcile   # run a subset of consumers in this process

# ---------- M-Pesa (Daraja STK Push) ----------
# simulate (default without keys) | sandbox | production
MPESA_MODE=simulate
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# Sandbox test shortcode and passkey (published by Safaricom for testing):
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Public https URL of this API (e.g. an ngrok tunnel in development); Daraja posts callbacks to
#   $PUBLIC_API_URL/api/mpesa/callback/$MPESA_CALLBACK_TOKEN
# PUBLIC_API_URL=https://your-api.example.com
# Long random secret, e.g. `openssl rand -hex 32`
# MPESA_CALLBACK_TOKEN=
MPESA_STATUS_CHECK_DELAY_MS=60000
MPESA_MAX_STATUS_CHECKS=5

# ---------- Card payments (Stripe) ----------
# Card payments are offered when STRIPE_SECRET_KEY is set. Use test keys (sk_test_/pk_test_) until launch.
# Dashboard → Developers → API keys. Charges are in KES (your Stripe account must support KES).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Dashboard → Developers → Webhooks → add endpoint $PUBLIC_API_URL/api/stripe/webhook with events
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled; paste its signing secret.
# Locally: `stripe listen --forward-to localhost:5000/api/stripe/webhook` prints a whsec_ to use here.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Minutes (one status check per MPESA_STATUS_CHECK_DELAY_MS) before an unfinished card payment is cancelled.
STRIPE_MAX_STATUS_CHECKS=30
PAYMENT_RATE_LIMIT_PER_10_MIN=5

# ---------- Meter readings ----------
# Shared secret for meter gateways posting to /api/readings (X-Api-Key header). `openssl rand -hex 32`
METER_INGEST_API_KEY=change-me
HIGH_USAGE_LITRES_PER_DAY=2000

# ---------- Billing ----------
BILL_DUE_DAYS=14
BILLING_GRACE_HOURS=6
# BILLING_SCHEDULER=off      # disable the automatic monthly run in this worker

# ---------- Notifications ----------
# SMS via Africa's Talking (AT_USERNAME=sandbox for the sandbox). Without AT_API_KEY, SMS are only logged.
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
# Email via SMTP (Amazon SES SMTP, Gmail, Mailgun...). Without SMTP_HOST, emails are only logged.
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Maji ya Umma <no-reply@your-domain>
SUPPORT_EMAIL=support@example.com
