rules_version = '2';

// Firestore is no longer used: data moved to Amazon DynamoDB (see
// Backend/scripts/migrate-from-firestore.js). The project keeps Firebase Auth
// for sign-in only. These rules deny all access so the old data stays as a
// private backup.
//
// Deploy with:
//   npx firebase-tools deploy --only firestore:rules --project maji-ya-umma
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
